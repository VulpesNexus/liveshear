# Build output: the plugin binary, its intermediates, and the generated PIPL.
build/
plugin/plugin.pipl
*.aip
*.pdb
*.ilk
*.obj
*.lib
*.exp

# Harness build output (tools/AboutHarness/build.cmd).
tools/AboutHarness/*.exe
tools/AboutHarness/*.res

# Visual Studio user state.
*.user
*.suo
.vs/

# Python bytecode.
__pycache__/
*.pyc

# Assembled release archives; they are built, not kept.
dist/

# Crash-recovery transcript from a probe that did not run to the end. Named
# .partial rather than .txt on purpose, so the release gate cannot mistake it
# for evidence, and ignored here so a died-halfway run cannot leave something
# committable behind. The real transcript is written only on completion.
docs/evidence/*.partial
